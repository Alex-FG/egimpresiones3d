# Solo el script del formulario se puede llamar desde el navegador.
# La configuración, la plantilla y PHPMailer quedan bloqueados.
Options -Indexes

<IfModule mod_authz_core.c>
    Require all denied
    <Files "rd-mailform.php">
        Require all granted
    </Files>
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
    <Files "rd-mailform.php">
        Allow from all
    </Files>
</IfModule>
